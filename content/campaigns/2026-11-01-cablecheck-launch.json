x}\n.landscape .vitals{display:flex;gap:4px}\n.landscape .gauge{width:min(17vw,110px)}\n.landscape .words{width:54%;flex-basis:54%}\n.landscape .deck{font-size:clamp(11px,2.45vw,16px)}\n.landscape .status{font-size:clamp(7px,1vw,10px)}\n.landscape .graph{height:28px}\n@media (max-width:340px){.portrait .brand{margin-bottom:4%}.portrait .deck{margin-bottom:4%}.portrait .stage{max-height:40%}.portrait .feature{margin-top:4%}.portrait .head{font-size:clamp(23px,7.2vw,27px)}.wide .words{width:61%;flex-basis:61%}}\n@media (prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}\n</style><section class=\"ad portrait\" aria-label=\"CableCheck\"><div class=\"brand\"><span>Cable<b>Check</b></span></div><div class=\"eyebrow\">{{eyebrow}}</div><h1 class=\"head\">{{headline}}</h1><p class=\"deck\">{{deck}}</p><div class=\"stage\" aria-hidden=\"true\"><div class=\"gauge\" aria-hidden=\"true\"><div class=\"bolt\"></div></div><div class=\"vitals\" aria-hidden=\"true\"><div class=\"status\"><span>MONITOR</span></div><div class=\"graph\"></div><div class=\"vitals-mark\"><span>W · °C</span><span>mA</span></div></div></div><div class=\"feature\"><div class=\"micro\"><span class=\"line\"></span><span class=\"diff\"></span><span class=\"circle\"></span></div><span class=\"points\"><i></i><i></i><i></i></span></div><div class=\"foot\">{{footer}}</div></section>",
