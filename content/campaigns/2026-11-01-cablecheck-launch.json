    "portraitHtmlTemplate": "<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}\n:root{--bg:#050706;--surface:#0A0D0B;--raised:#111713;--line:#1E2720;--green:#4FE36B;--blue:#69D2FF;--text:#F6F8F6;--mute:#A4ACA6}\n.ac{position:relative;isolation:isolate;width:100%;height:100%;min-width:0;overflow:hidden;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--text);background:radial-gradient(ellipse at 82% 12%,rgba(79,227,107,.105),transparent 38%),linear-gradient(138deg,#050706 15%,#0A100C 72%,#050706 100%)}\n.ac:before{content:'';position:absolute;inset:0;opacity:.27;pointer-events:none;background:linear-gradient(135deg,transparent 47%,rgba(79,227,107,.04) 48%,transparent 49%)}\n.ac::after{content:'';position:absolute;inset:0;border:1px solid rgba(164,172,166,.17);border-radius:inherit;pointer-events:none}\n.brand{position:relative;z-index:2;display:flex;align-items:center;gap:10px;flex:0 0 auto;white-space:nowrap}\n.brand-mark{width:34px;height:34px;border:1px solid #34543B;border-radius:12px;background:#122019;position:relative;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px #172E1C}\n.brand-mark .cell{width:17px;height:22px;border:2px solid var(--green);border-radius:4px;position:relative;overflow:hidden}\n.brand-mark .cell:before{content:'';position:absolute;left:4px;right:4px;top:3px;height:3px;border-radius:3px;background:var(--green)}\n.brand-mark .cell:after{content:'';position:absolute;left:2px;right:2px;bottom:2px;height:9px;border-radius:2px;background:var(--green);opacity:.7}\n.brand-mark .cap{position:absolute;top:5px;right:12px;width:9px;height:3px;border-radius:3px;background:var(--green)}\n.brand-name{font-size:19px;line-height:1;letter-spacing:-.9px;font-weight:900}.brand-name i{color:var(--green);font-style:normal}\n.brand-note{margin-left:auto;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#8CAB91;border:1px solid #28412C;border-radius:99px;