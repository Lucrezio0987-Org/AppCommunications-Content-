/\n.landscape{border-radius:18px;display:flex;align-items:center;padding:6% 6.8%;gap:3%}\n.landscape .copy{position:relative;z-index:2;width:50%;flex:0 0 50%;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:8px;min-width:0}\n.landscape .brand{font-size:clamp(18px,3.2vw,26px)}\n.landscape .kicker{font-size:clamp(9px,1.6vw,12px)}\n.landscape .head{font-size:clamp(24px,4.5vw,43px)}\n.landscape .deck{font-size:clamp(12px,2.15vw,17px)}\n.landscape .foot{font-size:clamp(9px,1.5vw,12px);margin-top:3px}\n.landscape .hero{flex:1;height:82%;margin-left:0;padding:13px 11px;gap:11px;border-radius:18px}\n.landscape .gauge{width:min(16.5vw,130px)}\n.landscape .metrics{gap:7px}\n.landscape .curve{height:38px}\n@media(max-width:340px){.poster .brand{margin-bottom:6%}.poster .head{font-size:clamp(22px,7vw,25px)}.poster .hero{margin-top:4%}.poster .pillars{margin-top:4%;height:43px}.poster .gauge{width:30vw}.inbox .head{font-size:clamp(17px,5.4vw,20px)}.inbox .hero{width:32%}.inbox .gauge{width:22vw}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}\n</style><section class=\"creative inbox\" aria-label=\"CableCheck\"><div class=\"copy\"><div class=\"brand\"><i class=\"appmark\" aria-hidden=\"true\"></i><span>Cable<b>Check</b></span></div><div class=\"kicker\">{{eyebrow}}</div><h2 class=\"head\">{{headline}}</h2><div class=\"foot\">{{footer}}</div></div><div class=\"hero\" aria-hidden=\"true\"><div class=\"gauge\" aria-hidden=\"true\"><div class=\"cell\"></div></div><div class=\"metrics\" aria-hidden=\"true\"><div class=\"label\">MONITOR</div><div class=\"curve\"></div><div class=\"legend\"><span>W · °C</span><b>mA</b></div></div></div></section>"
