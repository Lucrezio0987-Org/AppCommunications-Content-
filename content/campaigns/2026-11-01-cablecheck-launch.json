    "inboxHtmlTemplate": "<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}\n:root{--bg:#050706;--surface:#0A0D0B;--raised:#111713;--line:#1E2720;--green:#4FE36B;--blue:#69D2FF;--text:#F6F8F6;--mute:#A4ACA6}\n.ac{position:relative;isolation:isolate;width:100%;height:100%;min-width:0;overflow:hidden;font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:var(--text);background:radial-gradient(ellipse at 82% 12%,rgba(79,227,107,.105),transparent 38%),linear-gradient(138deg,#050706 15%,#0A100C 72%,#050706 100%)}\n.ac:before{content:'';position:absolute;inset:0;opacity:.27;pointer-events:none;background:linear-gradient(135deg,transparent 47%,rgba(79,227,107,.04) 48%,transparent 49%)}\n.ac::after{content:'';position:absolute;inset:0;border:1px solid rgba(164,172,166,.17);border-radius:inherit;pointer-events:none}\n.brand{position:relative;z-index:2;display:flex;align-items:center;gap:10px;flex:0 0 auto;white-space:nowrap}\n.brand-mark{width:34px;height:34px;border:1px solid #34543B;border-radius:12px;background:#122019;position:relative;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 0 0 1px #172E1C}\n.brand-mark .cell{width:17px;height:22px;border:2px solid var(--green);border-radius:4px;position:relative;overflow:hidden}\n.brand-mark .cell:before{content:'';position:absolute;left:4px;right:4px;top:3px;height:3px;border-radius:3px;background:var(--green)}\n.brand-mark .cell:after{content:'';position:absolute;left:2px;right:2px;bottom:2px;height:9px;border-radius:2px;background:var(--green);opacity:.7}\n.brand-mark .cap{position:absolute;top:5px;right:12px;width:9px;height:3px;border-radius:3px;background:var(--green)}\n.brand-name{font-size:19px;line-height:1;letter-spacing:-.9px;font-weight:900}.brand-name i{color:var(--green);font-style:normal}\n.brand-note{margin-left:auto;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:#8CAB91;border:1px solid #28412C;border-radius:99px;padding:6px 9px}\n.eyebrow{font-size:9px;letter-spacing:.19em;text-transform:uppercase;font-weight:900;color:var(--green);line-height:1.3}\n.head{font-weight:900;letter-spacing:-.055em;margin:0;color:#F6F8F6;overflow-wrap:normal;word-break:normal}\n.deck{font-weight:500;line-height:1.4;color:var(--mute);margin:0}\n.foot{position:relative;z-index:2;font-size:9px;font-weight:850;letter-spacing:.16em;text-transform:uppercase;color:#8CAC94}\n.energy{position:relative;z-index:1;display:flex;align-items:center;border:1px solid #223527;background:linear-gradient(125deg,#111A13,#090D0B);overflow:hidden}\n.energy:before{content:'';position:absolute;inset:0;opacity:.45;background:repeating-linear-gradient(90deg,transparent 0,transparent 38px,#18261B 39px,#18261B 40px)}\n.ring{width:105px;height:105px;flex:0 0 auto;border-radius:100%;position:relative;display:grid;place-items:center;background:conic-gradient(var(--green) 0deg 240deg,#243328 240deg 360deg);box-shadow:0 0 35px #4FE36B13}\n.ring:before{content:'';position:absolute;inset:8px;background:#101711;border-radius:inherit}\n.ring:after{content:'';position:absolute;inset:19px;border:1px solid #345039;border-radius:inherit}\n.unit{z-index:1;text-align:center;line-height:.98;font-size:26px;font-weight:900;letter-spacing:-1.2px;color:#DAFEE0}\n.unit small{display:block;margin-top:5px;letter-spacing:.18em;font-size:7px;font-weight:900;color:#85AC8C}\n.visualdata{min-width:0;flex:1;display:flex;flex-direction:column;justify-content:center;gap:9px}\n.energy-tag{font-weight:800;color:#9FCCA8;letter-spacing:.12em;font-size:8px;text-transform:uppercase}\n.trace{height:37px;position:relative;overflow:hidden;display:flex;align-items:end;gap:5px;border-bottom:1px solid #34523B;padding-bottom:4px}\n.trace b{display:block;flex:1;max-width:15px;background:linear-gradient(0deg,#256D36,var(--green));opacity:.85;border-radius:3px 3px 0 0;transform-origin:bottom center;animation:lift 2.8s ease-in-out infinite alternate}\n.trace b:nth-child(1){height:38%;animation-delay:-.7s}.trace b:nth-child(2){height:58%;animation-delay:-1.2s}.trace b:nth-child(3){height:49%;animation-delay:-.2s}.trace b:nth-child(4){height:82%;animation-delay:-1.6s}.trace b:nth-child(5){height:70%;animation-delay:-.9s}.trace b:nth-child(6){height:91%;animation-delay:-1.9s}.trace b:nth-child(7){height:66%;animation-delay:-.4s}.trace b:nth-child(8){height:73%;animation-delay:-1.4s}\n.stats{display:flex;align-items:center;gap:8px;flex-wrap:wrap;font-size:9px;color:#9CAEA0;font-weight:700}\n.stats span{background:#16221A;border:1px solid #253A2A;padding:3px 6px;border-radius:6px}.stats span:nth-child(2){color:var(--blue);border-color:#1B3B47;background:#11222B}\n.portrait{border-radius:26px;display:flex;flex-direction:column;padding:7.5% 7.5% 6.5%}\n.portrait .brand-note{display:none}\n.portrait .copy{position:relative;z-index:2;margin-top:8%;flex:0 0 auto;display:flex;flex-direction:column;gap:8px}\n.portrait .head{font-size:clamp(25px,8.2vw,45px);line-height:1.04;max-width:98%}\n.portrait .deck{font-size:clamp(12px,3.7vw,18px);line-height:1.36;max-width:98%}\n.portrait .energy{border-radius:18px;flex:1;min-height:94px;margin-top:5%;gap:15px;padding:14px 13px}\n.portrait .ring{width:min(31vw,120px);height:min(31vw,120px)}\n.portrait .foot{margin-top:auto;padding-top:10px}\n.wide{border-radius:19px;display:flex;align-items:center;gap:0;padding:5.8% 6.5%}\n.wide .copy{position:relative;z-index:2;width:59%;flex:0 0 59%;min-width:0;display:flex;flex-direction:column;justify-content:center;gap:5px}\n.wide .brand{gap:7px;margin-bottom:4px}\n.wide .brand-mark{width:27px;height:27px;border-radius:9px;transform:scale(.88);transform-origin:left center;margin-right:-3px}\n.wide .brand-name{font-size:clamp(14px,4.6vw,26px)}\n.wide .brand-note{display:none}\n.wide .eyebrow{font-size:clamp(7px,2vw,11px)}\n.wide .head{font-size:clamp(18px,5.35vw,32px);line-height:1.07;max-width:96%}\n.wide .deck{font-size:clamp(10px,2.5vw,13px);line-height:1.26;max-width:98%}\n.wide .energy{align-self:stretch;flex:1;margin-left:3%;padding:10px 7px;border-radius:13px;display:flex;justify-content:center;align-items:center}\n.wide .ring{width:min(24vw,118px);height:min(24vw,118px)}\n.wide .unit{font-size:clamp(16px,5vw,23px)}\n.wide .unit small{font-size:6px}\n.wide .visualdata{display:none}\n.wide .foot{font-size:clamp(7px,1.8vw,10px);margin-top:4px}\n.wide-landscape .copy{width:59%;flex-basis:59%}\n.wide-landscape .deck{font-size:clamp(12px,3vw,16px)}\n@media(max-width:340px){.portrait .head{font-size:clamp(25px,8vw,30px)}.portrait .energy{gap:11px}.portrait .deck{font-size:12px}.portrait .copy{margin-top:5%}.portrait .energy{margin-top:4%}}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}\n@keyframes lift{from{transform:scaleY(.9)}to{transform:scaleY(1)}}\n</style><section class=\"ac wide\" aria-label=\"CableCheck\"><div class=\"copy\"><div class=\"brand\"><div class=\"brand-mark\" aria-hidden=\"true\"><div class=\"cell\"></div><div class=\"cap\"></div></div><span class=\"brand-name\">Cable<i>Check</i></span></div><div class=\"eyebrow\">{{eyebrow}}</div><h2 class=\"head\">{{headline}}</h2><div class=\"deck\">{{deck}}</div></div><div class=\"energy\" aria-hidden=\"true\"><div class=\"ring\"><div class=\"unit\">W<small>WATT</small></div></div><div class=\"visualdata\"><div class=\"energy-tag\">MONITOR</div><div class=\"trace\"><b></b><b></b><b></b><b></b><b></b><b></b><b></b><b></b></div><div class=\"stats\"><span>W</span><span>°C</span><span>mA</span></div></div></div></section>"
