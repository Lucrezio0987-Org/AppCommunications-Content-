ontent:'';position:absolute;inset:7px;background:#101611;border-radius:50%;}\n.gauge:after{content:'';position:absolute;inset:17px;border-radius:50%;border:1px solid #27392D}\n.bolt{position:relative;z-index:1;width:34%;height:46%;background:var(--green);clip-path:polygon(47% 0,96% 0,62% 42%,100% 42%,27% 100%,43% 56%,9% 56%);filter:drop-shadow(0 0 3px #4FE36B44)}\n.vitals{min-width:0;flex:1;display:flex;flex-direction:column;gap:8px;align-self:stretch;justify-content:center}\n.status{display:flex;align-items:center;gap:6px;color:var(--muted);font-weight:800;font-size:9px;letter-spacing:.08em;text-transform:uppercase}\n.status:before{content:'';display:block;width:6px;height:6px;background:var(--green);border-radius:50%;box-shadow:0 0 8px #4FE36B70}\n.graph{height:42px;position:relative;overflow:hidden;background:repeating-linear-gradient(to bottom,transparent 0,transparent 13px,#1A231D 14px);border-bottom:1px solid #27392d}\n.graph:before{content:'';position:absolute;left:0;right:0;bottom:12px;height:2px;transform:rotate(-10deg);background:linear-gradient(90deg,transparent,var(--green) 24%,var(--blue) 65%,transparent)}\n.graph:after{content:'';position:absolute;right:27%;top:14px;width:5px;height:5px;border-radius:50%;background:var(--blue);box-shadow:0 0 10px #69D2FF50}\n.vitals-mark{display:flex;align-items:center;justify-content:space-between;gap:5px;font-size:9px;font-weight:750;color:#829087}\n.vitals-mark span:last-child{color:var(--blue)}\n.feature{display:flex;align-items:center;justify-content:space-between;position:relative;color:var(--muted);font-size:10px;font-weight:750;letter-spacing:.055em}\n.feature:before{position:absolute;top:-8px;left:0;right:0;border-top:1px solid var(--border);content:''}\n.points{display:flex;align-items:center;gap:4px}.points i{display:block;height:4px;width:4px;background:var(--green);border-radius:50%}.points i:nth-child(2){background:var(--blue)}.points i:last-child{background:#F7C948}\n.micro{display:flex;gap:7px;align-items:center}\n.micro .line{height:3px;width:25px;border-radius:99px;background:linear-gradient(90deg,var(--green) 35%,var(--blue) 65%);opacity:.8}.micro .circle{width:12px;height:12px;border:2px solid var(--green);border-radius:50%;border-right-color:var(--border2)}.micro .diff{height:10px;width:14px;border-top:2px solid var(--blue);border-bottom:2px solid var(--green)}\n.foot{font-weight:800;font-size:9px;letter-spacing:.075em;color:#91AC97;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.portrait{display:flex;flex-direction:column;padding:6.5% 6.5% 5.5%;gap:0;border-radius:22px}\n.portrait .brand{margin-bottom:5%}\n.portrait .eyebrow{margin-bottom:2%}\n.portrait .head{font-size:clamp(24px,7.6vw,40px);margin-bottom:2.3%}\n.portrait .deck{font-size:clamp(11px,3.55vw,16px);margin-bottom:5%;max-width:98%}\n.portrait .stage{flex:1;gap:13px;padding:13px 11px;max-height:42%;min-height:85px}\n.portrait .gauge{width:min(30vw,118px)}\n.portrait .feature{margin-top:5%;height:20px}\n.portrait .foot{margin-top:auto;padding-top:8px}\n.wide{display:flex;align-items:center;padding:5.5% 6%;border-radius:16px}\n.wide .words{width:60%;flex:0 0 60%;min-width:0;z-index:1;position:relative;display:flex;flex-direction:column;justify-content:center;gap:5px}\n.wide .brand{font-size:clamp(14px,4.3vw,23px);margin-bottom:2px;gap:5px}\n.wide .brand:before{width:13px;height:19px;border-width:1.7px;border-radius:3px}\n.wide .eyebrow{font-size:clamp(7px,1.95vw,10px)}\n.wide .head{font-size:clamp(17px,5.2vw,32px);line-height:1.08;max-width:100%}\n.wide .deck{font-size:clamp(9px,2.3vw,14px);line-height:1.2;color:#B1B9B3}\n.wide .foot{font-size:clamp(7px,1.8vw,11px);margin-top:3px}\n.wide .stage{width:38%;flex:1;margin-left:3%;height:84%;border-radius:14px;display:grid;place-items:center;gap:0;padding:8px;min-height:0}\n.wide .gauge{width:min(23vw,115px)}\n.wide .vitals{display:none}\n.wide .feature{display:none}\n.landscape .stage{width:38%;height:88%;padding:10px;gap:10px;display:flex}\n.landscape .vitals{display:flex;gap:4px}\n.landscape .gauge{width:min(17vw,110px)}\n.landscape .words{width:54%;flex-basis:54%}\n.landscape .deck{font-size:clamp(11px,2.45vw,16px)}\n.landscape .status{font-size:clamp(7px,1vw,10px)}\n.landscape .graph{height:28px}\n@media (max-width:340px){.portrait .brand{margin-bottom:4%}.portrait .deck{margin-bottom:4%}.portrait .stage{max-height:40%}.portrait .feature{margin-top:4%}.portrait .head{font-size:clamp(23px,7.2vw,27px)}.wide .words{width:61%;flex-basis:61%}}\n@media (prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}\n</style><section class=\"ad wide\" aria-label=\"CableCheck\"><div class=\"words\"><div class=\"brand\"><span>Cable<b>Check</b></span></div><div class=\"eyebrow\">{{eyebrow}}</div><h2 class=\"head\">{{headline}}</h2><p class=\"deck\">{{deck}}</p></div><div class=\"stage\" aria-hidden=\"true\"><div class=\"gauge\" aria-hidden=\"true\"><div class=\"bolt\"></div></div></div></section>"
